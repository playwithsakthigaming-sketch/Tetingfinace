# Sri Sennamal Finance — Environment Variables

# APP_URL: Base URL for passbook link generation and API callbacks
APP_URL="https://your-domain.vercel.app"

# Owner Configuration
VITE_OWNER_EMAIL="playwithsakthigaming@gmail.com"

# Supabase Configuration (Optional for cloud sync; fallback to local persistent storage when not configured)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-never-share-client-side"

# Timezone & Currency Defaults
VITE_DEFAULT_TIMEZONE="Asia/Kolkata"
VITE_CURRENCY_SYMBOL="₹"

